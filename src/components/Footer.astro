---
import { siteData } from '../config/siteData';

const currentYear = new Date().getFullYear();
const { brand, learn, tools, support } = siteData.footer;
---

<footer class="footer">
  <div class="container">
    <!-- Sitemap grid: brand + three link columns -->
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <h3>{brand.name}</h3>
        <p class="brand-tagline">{brand.tagline}</p>
        <a href={support.donate} class="donate-chip">♥ Keep it free</a>
      </div>

      <!-- Learn -->
      <nav class="footer-col" aria-label="Learn">
        <h4>Learn</h4>
        <ul>
          {learn.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener noreferrer' : undefined}
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Free tools (sister products) -->
      <nav class="footer-col" aria-label="Free tools">
        <h4>Free tools</h4>
        <ul>
          {tools.map((t) => (
            <li>
              <a href={t.href} target="_blank" rel="noopener noreferrer">{t.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Support -->
      <nav class="footer-col" aria-label="Support">
        <h4>Support</h4>
        <ul>
          <li><a href={support.donate}>Donate</a></li>
          <li><a href={support.paypal} target="_blank" rel="noopener noreferrer">PayPal</a></li>
          <li><a href={support.kofi} target="_blank" rel="noopener noreferrer">Ko-fi</a></li>
        </ul>
        <p class="support-note">
          Everything here is free and open source. Donations keep it that way.
        </p>
      </nav>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p>© {currentYear} {brand.copyright}</p>
      <p class="built-with">Built with Claude Code, by a marketer</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 56px 24px 28px;
    border-top: 2px solid var(--border-color);
    font-size: 0.95em;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Sitemap grid: brand column wider than link columns */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* Brand */
  .footer-brand h3 {
    font-family: var(--font-display);
    font-size: 1.3em;
    color: var(--rust);
    margin: 0 0 10px 0;
    font-weight: 600;
  }

  .brand-tagline {
    margin: 0 0 18px 0;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 34ch;
  }

  /* Donate chip: small, hard-edged, on-brand */
  .donate-chip {
    display: inline-block;
    padding: 8px 16px;
    background: var(--rust);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9em;
    border: 2px solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.15s ease;
  }

  .donate-chip:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--border-color);
  }

  /* Link columns */
  .footer-col h4 {
    margin: 0 0 14px 0;
    font-size: 0.8em;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer-col a {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--rust);
    border-bottom-color: var(--rust);
  }

  .support-note {
    margin: 16px 0 0;
    font-size: 0.85em;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.5;
    max-width: 24ch;
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    font-size: 0.85em;
    color: var(--text-secondary);
  }

  .footer-bottom p {
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer {
      padding: 40px 20px 24px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
