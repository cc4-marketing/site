---
// Top bar fed by src/data/hellobar.json (site-kick scheduled HelloBar). Edit the file with
// `npx site-kick hellobar`, never by hand. Same selection as the kit component
// (site-kick/components/HelloBar.astro): every enabled bar that has not ended renders hidden and the
// script shows the first one whose window holds the visitor's clock and that the visitor has not
// dismissed within cooldownDays (localStorage, key = bar id). cc4 keeps its own markup for the icon
// and brand styling, which the kit component has no slot for.
import { hellobarCandidates, parseHellobar } from 'site-kick/lib/hellobar.js';

interface Props {
    config: unknown;
}

const bars = hellobarCandidates(parseHellobar(Astro.props.config));
const iso = (s?: string) => (s ? new Date(s).toISOString() : undefined);
const external = (url: string) => /^https?:\/\//.test(url);
---

{bars.map((bar) => (
    <div class="hello-bar" data-hello-bar data-id={bar.id} data-starts={iso(bar.startsAt)} data-ends={iso(bar.endsAt)} data-cooldown-days={bar.cooldownDays} hidden>
        <div class="hello-bar-content">
            <span class="hello-bar-icon">&#x1F4E6;</span>
            <span class="hello-bar-text">{bar.text}</span>
            <a href={bar.linkUrl} class="hello-bar-link" {...(external(bar.linkUrl) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                {bar.linkText} &rarr;
            </a>
        </div>
        <button class="hello-bar-close" aria-label="Close banner">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
        </button>
    </div>
))}

<style>
    .hello-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: linear-gradient(90deg, #1a1a1a 0%, #2d1f3d 100%);
        color: white;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        z-index: 1000;
        font-size: 0.9em;
        transform: translateY(-100%);
        opacity: 0;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .hello-bar[hidden] {
        display: none;
    }

    .hello-bar.visible {
        transform: translateY(0);
        opacity: 1;
        margin-bottom: 42px;
    }

    .hello-bar.hiding {
        transform: translateY(-100%);
        opacity: 0;
    }

    .hello-bar-content {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .hello-bar-icon {
        font-size: 1.1em;
    }

    .hello-bar-text {
        color: rgba(255, 255, 255, 0.9);
    }

    .hello-bar-link {
        color: #00D4AA;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.15s;
    }

    .hello-bar-link:hover {
        color: #00F5C4;
        text-decoration: underline;
    }

    .hello-bar-close {
        position: absolute;
        right: 16px;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s;
    }

    .hello-bar-close:hover {
        color: white;
    }

    @media (max-width: 600px) {
        .hello-bar {
            padding: 10px 40px 10px 16px;
            font-size: 0.82em;
        }

        .hello-bar-content {
            flex-wrap: wrap;
            justify-content: center;
            gap: 4px 8px;
        }
    }
</style>

<script>
    // Start inclusive, end exclusive, same as site-kick lib/hellobar.js. First open, undismissed bar wins.
    const now = Date.now();
    let shown: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>('[data-hello-bar]').forEach((bar) => {
        const d = bar.dataset;
        let at = 0;
        const open = !shown && !(d.starts && Date.parse(d.starts) > now) && !(d.ends && Date.parse(d.ends) <= now);
        if (open) { try { at = Number(localStorage.getItem(d.id!)); } catch { /* storage blocked: just show it */ } }
        if (open && !(at && now - at < Number(d.cooldownDays || 3) * 864e5)) shown = bar;
        else bar.remove();
    });
    const bar = shown as HTMLElement | null;
    if (bar) {
        bar.hidden = false;
        setTimeout(() => bar.classList.add('visible'), 100);
        bar.querySelector('.hello-bar-close')?.addEventListener('click', () => {
            bar.classList.add('hiding');
            bar.classList.remove('visible');
            try { localStorage.setItem(bar.dataset.id!, String(Date.now())); } catch { /* storage blocked */ }
            setTimeout(() => bar.remove(), 300);
        });
    }
</script>
