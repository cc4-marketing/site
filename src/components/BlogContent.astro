---
import { PortableText } from 'emdash/ui';
import { slugify } from '../lib/blog-slugify';

interface Props {
  blocks: any[];
}

const { blocks } = Astro.props;

// Group consecutive standard blocks so PortableText handles list wrapping.
// Custom types (code, blogImage) break the group and render directly.
type Segment =
  | { kind: 'portable'; blocks: any[]; headingId?: string }
  | { kind: 'code'; language: string; code: string; key: string }
  | { kind: 'image'; url: string; alt: string; key: string }
  | { kind: 'releaseBox'; data: any; key: string }
  | { kind: 'chatMessage'; text: string; key: string }
  | { kind: 'table'; headers: string[]; rows: string[][]; caption?: string; key: string };

const segments: Segment[] = [];
let current: any[] = [];

for (const block of blocks) {
  if (block._type === 'code') {
    if (current.length) { segments.push({ kind: 'portable', blocks: current }); current = []; }
    segments.push({ kind: 'code', language: block.language || 'text', code: block.code, key: block._key });
  } else if (block._type === 'blogImage') {
    if (current.length) { segments.push({ kind: 'portable', blocks: current }); current = []; }
    segments.push({ kind: 'image', url: block.url, alt: block.alt || '', key: block._key });
  } else if (block._type === 'releaseHighlight') {
    if (current.length) { segments.push({ kind: 'portable', blocks: current }); current = []; }
    segments.push({ kind: 'releaseBox', data: block, key: block._key });
  } else if (block._type === 'chatMessage') {
    if (current.length) { segments.push({ kind: 'portable', blocks: current }); current = []; }
    segments.push({ kind: 'chatMessage', text: block.text || '', key: block._key });
  } else if (block._type === 'table') {
    if (current.length) { segments.push({ kind: 'portable', blocks: current }); current = []; }
    segments.push({
      kind: 'table',
      headers: block.headers || [],
      rows: block.rows || [],
      caption: block.caption,
      key: block._key,
    });
  } else {
    // If this is an h2 block, flush current and start a new segment with the heading id
    if (block._type === 'block' && block.style === 'h2') {
      if (current.length) { segments.push({ kind: 'portable', blocks: current }); current = []; }
      const headingText = block.children?.[0]?.text || '';
      const headingId = slugify(headingText);
      segments.push({ kind: 'portable', blocks: [block], headingId });
    } else {
      current.push(block);
    }
  }
}
if (current.length) segments.push({ kind: 'portable', blocks: current });
---

{segments.map((seg) => {
  if (seg.kind === 'code') {
    return (
      <pre><code class={`language-${seg.language}`}>{seg.code}</code></pre>
    );
  }
  if (seg.kind === 'image') {
    return (
      <figure class="blog-inline-image">
        <img src={seg.url} alt={seg.alt} loading="lazy" />
      </figure>
    );
  }
  if (seg.kind === 'chatMessage') {
    return (
      <div class="blog-chat-message">
        <div class="blog-chat-message-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          What I actually typed
        </div>
        <p class="blog-chat-message-text">{seg.text}</p>
      </div>
    );
  }
  if (seg.kind === 'table') {
    return (
      <figure class="blog-table">
        <table>
          <thead>
            <tr>{seg.headers.map((h) => <th>{h}</th>)}</tr>
          </thead>
          <tbody>
            {seg.rows.map((row) => (
              <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
        {seg.caption && <figcaption>{seg.caption}</figcaption>}
      </figure>
    );
  }
  if (seg.kind === 'releaseBox') {
    const { version, downloadUrl, landingPageUrl, sourceUrl } = seg.data;
    return (
      <div class="blog-release-box">
        <strong>v{version}</strong>
        <p>
          Download: <a href={`https://${downloadUrl}`} target="_blank" rel="noopener noreferrer">{downloadUrl}</a><br />
          Landing page: <a href={`https://${landingPageUrl}`} target="_blank" rel="noopener noreferrer">{landingPageUrl}</a><br />
          Source: <a href={`https://${sourceUrl}`} target="_blank" rel="noopener noreferrer">{sourceUrl}</a>
        </p>
      </div>
    );
  }
  if (seg.headingId) {
    return (
      <div id={seg.headingId}>
        <PortableText value={seg.blocks} />
      </div>
    );
  }
  return <PortableText value={seg.blocks} />;
})}

<style>
  .blog-inline-image {
    margin: 2rem 0;
    text-align: center;
  }
  .blog-inline-image img {
    max-width: 100%;
    border-radius: 4px;
  }

  .blog-chat-message {
    margin: 1.75em 0;
    max-width: 88%;
    background: var(--tint-plum-1);
    border: 3px solid var(--ink-100);
    border-radius: 4px 16px 16px 16px;
    box-shadow: 6px 6px 0 var(--shadow-ink);
    padding: 14px 20px 16px;
  }

  .blog-chat-message-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--plum);
    margin-bottom: 8px;
  }

  .blog-chat-message-text {
    margin: 0;
    font-family: monospace;
    font-size: 0.98em;
    line-height: 1.55;
    color: var(--ink-100);
  }

  @media (max-width: 640px) {
    .blog-chat-message {
      max-width: 100%;
    }
  }

  .blog-table {
    margin: 2rem 0;
    overflow-x: auto;
  }

  .blog-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
  }

  .blog-table th,
  .blog-table td {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--tint-rust-3);
    white-space: nowrap;
  }

  .blog-table thead th {
    background: var(--rust);
    color: var(--tint-rust-1);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .blog-table tbody th[scope='row'] {
    font-weight: 600;
    color: var(--ink-100);
    background: var(--tint-rust-1);
  }

  .blog-table tbody tr:nth-child(even) td {
    background: var(--tint-rust-1);
  }

  .blog-table figcaption {
    margin-top: 8px;
    font-size: 0.82em;
    color: var(--text-secondary);
    font-style: italic;
  }

  .blog-release-box {
    border-left: 4px solid var(--rust);
    padding: 20px 24px;
    margin: 32px 0;
    background: var(--tint-rust-1);
  }

  .blog-release-box strong {
    display: block;
    margin-bottom: 12px;
    color: var(--rust);
    font-weight: 600;
  }

  .blog-release-box p {
    margin: 0;
    font-size: 0.95em;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .blog-release-box a {
    color: var(--rust);
    text-decoration: underline;
  }

  .blog-release-box a:hover {
    opacity: 0.8;
  }
</style>
