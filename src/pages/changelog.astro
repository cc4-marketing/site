---

import { siteData } from '../config/siteData';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { z } from 'astro/zod';

const apiUrl = siteData.changelog.apiUrl;

const entrySchema = z.object({
  id: z.string().min(1),
  title: z.string().trim().min(1),
  summary: z.string(),
  type: z.string().trim().min(1),
  version: z.string().trim().min(1),
  published_at: z.string().refine(value => Number.isFinite(Date.parse(value))),
  status: z.string().optional(),
  modules: z.array(z.string()).optional(),
  machine_summary: z.string().nullish(),
});
type ChangelogEntry = z.infer<typeof entrySchema>;

const typeLabels = new Map([
  ['added', 'Added'], ['changed', 'Changed'], ['deprecated', 'Deprecated'],
  ['removed', 'Removed'], ['fixed', 'Fixed'], ['security', 'Security'],
]);
const typeClass = (type: string) => typeLabels.has(type) ? `type-${type}` : '';
const scopeOf = (entry: ChangelogEntry) => entry.modules?.includes('course') ? 'course' : 'site';
const formatDate = (date: string) => new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
let entries: ChangelogEntry[] = [];
let unavailable = false;
const controller = new AbortController();
const timeout = setTimeout(() => controller.abort(), 5000);
try {
  const response = await fetch(`${apiUrl}/api/changelog`, { signal: controller.signal });
  if (!response.ok) throw new Error(`Changelog upstream returned ${response.status}`);
  const data = z.object({ entries: z.array(entrySchema) }).parse(await response.json());
  entries = data.entries.filter(entry => !entry.status || entry.status === 'published');
} catch (error) {
  unavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '300');
  Astro.response.headers.set('Cache-Control', 'no-store');
  console.error('Changelog unavailable:', error);
} finally {
  clearTimeout(timeout);
}
const groups = new Map<string, ChangelogEntry[]>();
const typeCounts = new Map<string, number>();
for (const entry of entries) {
  const group = groups.get(entry.version);
  if (group) group.push(entry);
  else groups.set(entry.version, [entry]);
  typeCounts.set(entry.type, (typeCounts.get(entry.type) || 0) + 1);
}
const courseCount = entries.filter(entry => scopeOf(entry) === 'course').length;
---

<BaseLayout
  title="Changelog"
  description="Track every update, improvement, and fix to the Claude Code for Marketers course and website. Filter by type, search, and subscribe via RSS."
  keywords={['changelog', 'updates', 'Claude Code for Marketers', 'release notes', 'course updates']}
  ogPageKey="changelog"
  canonical="https://cc4.marketing/changelog/"
  showCourseSchema={false}
  showBreadcrumb={false}
>
  <Header latestChangelogId={entries[0]?.id ?? ''} />

  <section class="cl-hero">
    <div class="cl-hero-pattern"></div>
    <div class="cl-hero-inner">
      <span class="cl-hero-label">Stay Updated</span>
      <h1 class="cl-hero-title">Changelog</h1>
      <p class="cl-hero-desc">Every update, improvement, and fix, for humans and machines alike.</p>
      <div class="cl-hero-meta" id="hero-meta">
        {entries.length > 0 && <>Latest: <strong>{entries[0].version === 'unreleased' ? 'Unreleased' : `v${entries[0].version}`}</strong> · {formatDate(entries[0].published_at)}</>}
      </div>
      <div class="cl-feed-links">
        <a href={`${apiUrl}/rss.xml`} target="_blank" rel="noopener" class="cl-feed-pill">RSS</a>
        <a href={`${apiUrl}/feed.json`} target="_blank" rel="noopener" class="cl-feed-pill">JSON Feed</a>
        <a href="/llms.txt" class="cl-feed-pill">llms.txt</a>
      </div>
    </div>
  </section>

  <div class="cl-controls" id="cl-controls" hidden>
    <div class="cl-controls-inner">
      <div class="cl-scope-pills">
        <button class="cl-scope cl-scope--active" data-scope="all">All</button>
        <button class="cl-scope" data-scope="site"><span class="cl-scope-icon cl-scope-icon--site"></span>Website</button>
        <button class="cl-scope" data-scope="course"><span class="cl-scope-icon cl-scope-icon--course"></span>Course</button>
      </div>
      <span class="cl-filter-sep"></span>
      <div class="cl-filter-pills">
        <button class="cl-pill cl-pill--active" data-type="all">All</button>
        <button class="cl-pill" data-type="added"><span class="cl-pill-dot cl-dot--added"></span>Added</button>
        <button class="cl-pill" data-type="changed"><span class="cl-pill-dot cl-dot--changed"></span>Changed</button>
        <button class="cl-pill" data-type="fixed"><span class="cl-pill-dot cl-dot--fixed"></span>Fixed</button>
        <button class="cl-pill" data-type="security"><span class="cl-pill-dot cl-dot--security"></span>Security</button>
      </div>
      <input type="text" class="cl-search" id="cl-search" aria-label="Search updates" placeholder="Search updates..." autocomplete="off" />
    </div>
  </div>

  <section class="cl-body">
    <div class="cl-body-inner">
      {!unavailable && <div class="cl-stats" id="cl-stats">
        <span class="cl-stat-total">{entries.length} updates</span><span class="cl-stat-sep"></span>
        <span class="cl-stat-item"><span class="cl-stat-dot cl-stat-dot--site"></span>{entries.length - courseCount} Website</span>
        <span class="cl-stat-item"><span class="cl-stat-dot cl-stat-dot--course"></span>{courseCount} Course</span>
        <span class="cl-stat-sep"></span>
        {Array.from(typeCounts, ([type, count]) => <span class="cl-stat-item"><span class:list={['cl-stat-dot', typeClass(type)]}></span>{count} {typeLabels.get(type) || type}</span>)}
      </div>}

      <div class="cl-timeline" id="cl-timeline" hidden={!entries.length}>
        {Array.from(groups, ([version, items]) => (
          <div class:list={['cl-vgroup', { 'cl-vgroup--unreleased': version === 'unreleased' }]}>
            <div class="cl-vheader">
              <h2 class="cl-vlabel">{version === 'unreleased' ? 'Unreleased' : `v${version}`}</h2>
              {version !== 'unreleased' && <span class="cl-vdate">{items.length === 1 ? formatDate(items[0].published_at) : `${formatDate(items[items.length - 1].published_at)} to ${formatDate(items[0].published_at)}`}</span>}
              <span class="cl-vcount">{items.length} update{items.length > 1 ? 's' : ''}</span>
            </div>
            <div class="cl-ventries">
              {items.map(entry => {
                const scope = scopeOf(entry);
                const modules = (entry.modules || []).filter(module => module !== 'site' && module !== 'course');
                return <div class="cl-entry" data-type={entry.type} data-scope={scope} data-modules={(entry.modules || []).join(' ')}>
                  <div class:list={['cl-dot', typeClass(entry.type)]}></div>
                  <div class:list={['cl-card', `cl-card--${scope}`]}>
                    <div class:list={['cl-accent', typeClass(entry.type)]}></div>
                    <div class="cl-card-body">
                      <div class="cl-meta">
                        <span class:list={['cl-scope-tag', `cl-scope-tag--${scope}`]}>{scope === 'course' ? 'Course' : 'Website'}</span>
                        <span class:list={['cl-badge', typeClass(entry.type)]}>{typeLabels.get(entry.type) || entry.type}</span>
                        <span class="cl-ver">{entry.version === 'unreleased' ? 'unreleased' : `v${entry.version}`}</span>
                        <span class="cl-date">{formatDate(entry.published_at)}</span>
                      </div>
                      <h3 class="cl-entry-title">{entry.title}</h3>
                      <p class="cl-entry-desc">{entry.summary}</p>
                      {entry.machine_summary && <details class="cl-agent"><summary>Agent context</summary><p>{entry.machine_summary}</p></details>}
                      {modules.length > 0 && <div class="cl-mods">{modules.map(module => <span class="cl-mod">{module}</span>)}</div>}
                    </div>
                  </div>
                </div>;
              })}
            </div>
          </div>
        ))}
      </div>

      <div class="cl-empty" id="cl-empty" hidden={entries.length > 0} data-unavailable={unavailable}>
        <h3>{unavailable ? 'Changelog temporarily unavailable' : 'No updates found'}</h3>
        <p id="cl-empty-msg">{unavailable ? 'Could not load the changelog. Please try again later.' : 'No updates yet. Check back soon!'}</p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const timeline = document.getElementById('cl-timeline')!;
  const empty = document.getElementById('cl-empty')!;
  const search = document.getElementById('cl-search') as HTMLInputElement;
  const scopeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.cl-scope'));
  const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.cl-pill'));
  const entries = Array.from(timeline.querySelectorAll<HTMLElement>('.cl-entry'), element => ({
    element,
    search: [
      element.querySelector('.cl-entry-title')!.textContent,
      element.querySelector('.cl-entry-desc')!.textContent,
      element.dataset.modules,
    ].join(' ').toLowerCase(),
  }));
  const groups = Array.from(timeline.querySelectorAll<HTMLElement>('.cl-vgroup'));
  let activeScope = 'all';
  let activeType = 'all';

  function applyFilters(updateUrl = true) {
    const query = search.value.trim().toLowerCase();
    let count = 0;
    for (const entry of entries) {
      entry.element.hidden = !(
        (activeScope === 'all' || entry.element.dataset.scope === activeScope) &&
        (activeType === 'all' || entry.element.dataset.type === activeType) &&
        (!query || entry.search.includes(query))
      );
      if (!entry.element.hidden) count++;
    }
    for (const group of groups) {
      const visible = Array.from(group.querySelectorAll<HTMLElement>('.cl-entry')).filter(entry => !entry.hidden);
      group.hidden = visible.length === 0;
      group.querySelector('.cl-vcount')!.textContent = `${visible.length} update${visible.length === 1 ? '' : 's'}`;
      const date = group.querySelector('.cl-vdate');
      if (date && visible.length) {
        const first = visible[0].querySelector('.cl-date')!.textContent;
        const last = visible[visible.length - 1].querySelector('.cl-date')!.textContent;
        date.textContent = visible.length === 1 ? first : `${last} to ${first}`;
      }
    }
    timeline.hidden = count === 0;
    empty.hidden = count > 0;
    document.getElementById('cl-empty-msg')!.textContent =
      activeScope !== 'all' || activeType !== 'all' || query ? 'Try adjusting your filters or search.' : 'No updates yet. Check back soon!';
    for (const button of scopeButtons) button.classList.toggle('cl-scope--active', button.dataset.scope === activeScope);
    for (const button of typeButtons) button.classList.toggle('cl-pill--active', button.dataset.type === activeType);
    if (updateUrl) {
      const params = new URLSearchParams();
      if (activeScope !== 'all') params.set('scope', activeScope);
      if (activeType !== 'all') params.set('type', activeType);
      if (search.value.trim()) params.set('q', search.value.trim());
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
    }
  }

  function readFilters() {
    const params = new URLSearchParams(location.search);
    const scope = params.get('scope');
    const type = params.get('type');
    activeScope = scopeButtons.some(button => button.dataset.scope === scope) ? scope! : 'all';
    activeType = typeButtons.some(button => button.dataset.type === type) || entries.some(entry => entry.element.dataset.type === type) ? type! : 'all';
    search.value = params.get('q') || '';
    applyFilters(false);
  }

  if (empty.dataset.unavailable !== 'true') {
    document.getElementById('cl-controls')!.hidden = false;
    for (const button of scopeButtons) button.addEventListener('click', () => {
      activeScope = button.dataset.scope!;
      applyFilters();
    });
    for (const button of typeButtons) button.addEventListener('click', () => {
      activeType = button.dataset.type!;
      applyFilters();
    });
    search.addEventListener('input', () => applyFilters());
    window.addEventListener('popstate', readFilters);
    readFilters();
  }
</script>

<style>
  .cl-controls[hidden], .cl-timeline[hidden], .cl-vgroup[hidden], .cl-entry[hidden], .cl-empty[hidden] { display: none; }

  /* Reset section padding from global.css */
  .cl-hero, .cl-body { padding: 0; }

  /* ── HERO ─────────────────────────────────────── */
  .cl-hero {
    background: linear-gradient(135deg, #2C2C2C 0%, #1a1a2e 100%);
    color: white;
    position: relative;
    overflow: hidden;
  }

  html[data-theme="dark"] .cl-hero {
    background: linear-gradient(135deg, #1a1a1a 0%, #111122 100%);
  }

  .cl-hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(232, 185, 35, 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  .cl-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 120px 24px 56px;
    text-align: center;
  }

  .cl-hero-label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.85em;
    color: var(--mustard);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
  }

  .cl-hero-title {
    font-family: var(--font-display);
    font-size: 3.5em;
    color: white;
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .cl-hero-desc {
    font-size: 1.15em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 auto 20px;
    max-width: 500px;
    line-height: 1.7;
  }

  .cl-hero-meta {
    font-size: 0.9em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 20px;
  }

  .cl-hero-meta strong { color: var(--mustard); }

  .cl-feed-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cl-feed-pill {
    font-size: 0.78em;
    font-weight: 600;
    color: var(--mustard);
    text-decoration: none;
    border: 1px solid rgba(232, 185, 35, 0.35);
    padding: 4px 14px;
    transition: all 0.2s ease;
    letter-spacing: 0.04em;
  }

  .cl-feed-pill:hover {
    background: var(--mustard);
    color: #2C2C2C;
    border-color: var(--mustard);
  }

  /* ── CONTROLS (sticky filter bar) ─────────────── */
  .cl-controls {
    background: var(--bg-secondary);
    border-bottom: 2px solid var(--border-color);
    padding: 14px 24px;
    position: sticky;
    top: 60px;
    z-index: 10;
  }

  .cl-controls-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .cl-filter-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .cl-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    font-size: 0.8em;
    font-weight: 600;
    border: 2px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
  }

  .cl-pill:hover:not(.cl-pill--active) {
    border-color: var(--mustard);
    color: var(--text-primary);
  }

  .cl-pill--active {
    background: var(--charcoal);
    color: white;
    border-color: var(--charcoal);
  }

  html[data-theme="dark"] .cl-pill--active {
    background: var(--mustard);
    color: #1a1a1a;
    border-color: var(--mustard);
  }

  .cl-pill-dot {
    width: 8px;
    height: 8px;
    display: inline-block;
    flex-shrink: 0;
  }

  .cl-dot--added { background: #6B8E23; }
  .cl-dot--changed { background: #E8B923; }
  .cl-dot--fixed { background: #B85C3C; }
  .cl-dot--security { background: #5C3A6B; }

  /* ── SCOPE PILLS ──────────────────────────────── */
  .cl-scope-pills {
    display: flex;
    gap: 4px;
  }

  .cl-scope {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    font-size: 0.8em;
    font-weight: 700;
    border: 2px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
  }

  .cl-scope:hover:not(.cl-scope--active) {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }

  .cl-scope--active {
    background: var(--charcoal);
    color: white;
    border-color: var(--charcoal);
  }

  html[data-theme="dark"] .cl-scope--active {
    background: var(--mustard);
    color: #1a1a1a;
    border-color: var(--mustard);
  }

  .cl-scope-icon {
    width: 8px;
    height: 8px;
    display: inline-block;
    flex-shrink: 0;
  }

  .cl-scope-icon--site { background: #0D9488; }
  .cl-scope-icon--course { background: #5C3A6B; }

  .cl-filter-sep {
    width: 1px;
    height: 24px;
    background: var(--border-color);
    flex-shrink: 0;
  }

  .cl-search {
    flex: 1;
    min-width: 160px;
    padding: 7px 14px;
    font-size: 0.85em;
    border: 2px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .cl-search:focus { border-color: var(--mustard); }
  .cl-search::placeholder { color: var(--text-secondary); opacity: 0.5; }

  /* ── STATS RIBBON ─────────────────────────────── */
  .cl-stats {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 0.85em;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .cl-body-inner :global(.cl-stat-total) {
    font-weight: 700;
    color: var(--text-primary);
  }

  .cl-body-inner :global(.cl-stat-sep) {
    width: 1px;
    height: 14px;
    background: var(--border-color);
    display: inline-block;
  }

  .cl-body-inner :global(.cl-stat-item) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .cl-body-inner :global(.cl-stat-dot) {
    width: 8px;
    height: 8px;
    display: inline-block;
  }

  .cl-body-inner :global(.cl-stat-dot.type-added) { background: var(--olive); }
  .cl-body-inner :global(.cl-stat-dot.type-changed) { background: var(--mustard); }
  .cl-body-inner :global(.cl-stat-dot.type-fixed) { background: var(--rust); }
  .cl-body-inner :global(.cl-stat-dot.type-security) { background: var(--plum); }
  .cl-body-inner :global(.cl-stat-dot.type-deprecated) { background: #999; }
  .cl-body-inner :global(.cl-stat-dot.type-removed) { background: #EC4899; }
  .cl-body-inner :global(.cl-stat-dot--site) { background: #0D9488; }
  .cl-body-inner :global(.cl-stat-dot--course) { background: #5C3A6B; }

  /* ── BODY ─────────────────────────────────────── */
  .cl-body {
    background: var(--bg-primary);
    min-height: 60vh;
  }

  .cl-body-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 24px 100px;
  }

  /* ── TIMELINE ─────────────────────────────────── */
  .cl-body-inner :global(.cl-vgroup) {
    margin-bottom: 48px;
  }

  .cl-body-inner :global(.cl-vheader) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 3px solid var(--border-color);
    flex-wrap: wrap;
  }

  .cl-body-inner :global(.cl-vlabel) {
    font-family: var(--font-display);
    font-size: 1.5em;
    color: var(--text-primary);
    margin: 0;
    line-height: 1;
  }

  .cl-body-inner :global(.cl-vdate) {
    font-size: 0.82em;
    color: var(--text-secondary);
  }

  .cl-body-inner :global(.cl-vcount) {
    font-size: 0.78em;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    padding: 2px 10px;
    border: 1px solid var(--border-color);
  }

  .cl-body-inner :global(.cl-ventries) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-left: 28px;
    border-left: 2px solid var(--border-color);
  }

  /* ── ENTRY ────────────────────────────────────── */
  .cl-body-inner :global(.cl-entry) {
    position: relative;
  }

  .cl-body-inner :global(.cl-dot) {
    position: absolute;
    left: -35px;
    top: 22px;
    width: 12px;
    height: 12px;
    border: 3px solid var(--bg-primary);
    box-sizing: border-box;
  }

  .cl-body-inner :global(.cl-dot.type-added) { background: var(--olive); }
  .cl-body-inner :global(.cl-dot.type-changed) { background: var(--mustard); }
  .cl-body-inner :global(.cl-dot.type-fixed) { background: var(--rust); }
  .cl-body-inner :global(.cl-dot.type-security) { background: var(--plum); }
  .cl-body-inner :global(.cl-dot.type-deprecated) { background: #999; }
  .cl-body-inner :global(.cl-dot.type-removed) { background: #EC4899; }

  .cl-body-inner :global(.cl-card) {
    display: flex;
    background: var(--bg-secondary);
    border: 3px solid var(--border-color);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .cl-body-inner :global(.cl-card:hover) {
    transform: translate(-6px, -6px);
    box-shadow: 12px 12px 0 var(--mustard);
  }

  .cl-body-inner :global(.cl-accent) {
    width: 5px;
    flex-shrink: 0;
  }

  .cl-body-inner :global(.cl-accent.type-added) { background: var(--olive); }
  .cl-body-inner :global(.cl-accent.type-changed) { background: var(--mustard); }
  .cl-body-inner :global(.cl-accent.type-fixed) { background: var(--rust); }
  .cl-body-inner :global(.cl-accent.type-security) { background: var(--plum); }
  .cl-body-inner :global(.cl-accent.type-deprecated) { background: #999; }
  .cl-body-inner :global(.cl-accent.type-removed) { background: #EC4899; }

  .cl-body-inner :global(.cl-card-body) {
    padding: 22px 24px;
    flex: 1;
    min-width: 0;
  }

  .cl-body-inner :global(.cl-meta) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .cl-body-inner :global(.cl-scope-tag) {
    padding: 2px 8px;
    font-size: 0.68em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
