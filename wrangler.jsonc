{
  "name": "cc4-mkt",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-14",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "assets": {
    "directory": "./dist/client"
  },

  // D1 database for Emdash CMS
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc4-emdash",
      "database_id": "6745b124-0093-48fe-bf57-c12b35c4a70c"
    }
  ],

  // R2 bucket for media/image uploads
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cc4-media"
    }
  ],

  // Per-IP limit for /api/subscribe (each accepted request sends a real email).
  // period must be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  // Secrets (set via Cloudflare Dashboard or `wrangler secret put`):
  // - RESEND_API_KEY
  // - GITHUB_TOKEN
}
